# Copy to .env.local; never use NEXT_PUBLIC_ for these values.
OPENAI_API_KEY=

# Model used for the classroom chat challenge.
OPENAI_MODEL=gpt-4o-mini

# Set a private classroom flag. Never put the actual value in client code.
PROMPT_CHAT_FLAG=

# Optional: absolute path to a private, persistent directory on the server.
# Defaults to .data locally; Docker Compose sets /app/.data on its persistent volume.
# PROMPT_CHAT_DATA_DIR=/path/to/private/persistent/data
